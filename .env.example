# Environment Configuration for Foresight

# Operating Mode: live | offline
# In live mode, GROQ_API_KEY and HINDSIGHT_API_KEY are required.
# In offline mode, deterministic mock LLM and in-memory mock bank are used.
FORESIGHT_MODE=offline

# Backend Settings
PORT=8000
API_KEY=foresight-secret-key-123
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration (Groq)
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# Hindsight Memory Configuration
HINDSIGHT_API_KEY=
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=foresight-paynest
